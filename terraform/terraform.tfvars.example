# =============================================================================
# Mono-Ticket — Terraform Variable Configuration Example
# Copy this file to 'terraform.tfvars' to customize your deployment.
# =============================================================================

# AWS Region where the cluster will run
aws_region  = "us-east-1"
environment = "production"

# Compute Specs (t3.medium chosen per user requirement: 2 vCPU, 4 GiB RAM)
instance_type    = "t3.medium"
root_volume_size = 30 # GiB gp3

# Security Group - Allowed SSH CIDR blocks (recommend restricting to your IP)
# Example: allowed_ssh_cidr_blocks = ["203.0.113.50/32"]
allowed_ssh_cidr_blocks = ["0.0.0.0/0"]

# SSH Key Pair:
# - Leave empty to have Terraform automatically generate 'k3s-ticket-key.pem'
# - Or specify existing AWS Key Pair name: ssh_key_name = "my-existing-key"
# - Or paste public key material: ssh_public_key = "ssh-rsa AAAA..."
ssh_key_name     = ""
ssh_public_key   = ""
generate_ssh_key = true

# Bootstrapping (Swap memory, K3s installation, and Cert-Manager)
swap_size_gb         = 2
swappiness           = 10
install_k3s          = true
install_cert_manager = true
cert_manager_version = "v1.16.1"

# Route 53 DNS (Optional)
# If managing domain via AWS Route 53, set to true and supply domain & zone ID:
create_route53_records = false
domain_name            = "" # e.g. "yourdomain.com"
route53_zone_id        = "" # e.g. "Z0123456789ABCDEF"
