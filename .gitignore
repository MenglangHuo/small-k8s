# Root .gitignore for mono-ticket

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Cache
.idea/
*.iws
*.iml
*.ipr
.vscode/
*.swp
*.swo
*~

# Environment & Secrets (keep .env.example)
.env
.env.*
!.env.example
k8s/02-secrets.yaml
.mono-ticket-secrets

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend Cache & Build
node_modules/
dist/
dist-ssr/
coverage/
.eslintcache
*.tsbuildinfo
.oxlintcache

# Java / Gradle Cache & Build
.gradle/
build/
out/
bin/
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
*.class
*.jar
*.war
*.ear
!gradle/wrapper/gradle-wrapper.jar
