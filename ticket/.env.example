# ==========================================
# Ticket Microservice Environment Variables Example
# ==========================================

# Server Configuration
SERVER_PORT=8000
SPRING_PROFILES_ACTIVE=dev

# Database (Reactive MongoDB)
MONGODB_URI=mongodb://localhost:27017/ticket_db
# For Docker Compose use:
# MONGODB_URI=mongodb://mongo:27017/ticket_db

# AWS S3 Storage
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_PRIVATE=your-private-bucket
AWS_BUCKET_STATIC=your-static-bucket
AWS_PRIVATE_FILE_EXPIRED=3600
AWS_STATIC_URL=https://your-cdn.example.com
AWS_PRIVATE_URL=https://your-private-s3.example.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=your-secret-webhook-token
TELEGRAM_INVITE_EXPIRY_DAYS=7

# Ticket Engine Settings
TICKET_DEFAULT_PREFIX=TCK
TICKET_OUTBOX_POLLING_INTERVAL_MS=5000
